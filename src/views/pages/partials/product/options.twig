{#
    Product options + extras — rendered inside the buy form.
    Options UI is delegated to the Twilight web component.
#}
{% if product.options | length %}
    <salla-product-options options="{{ product.options }}" product-id="{{ product.id }}"></salla-product-options>
{% endif %}

{% if product.has_bundle_products %}
    <salla-multiple-bundle-product bundle-sections='{{ product | json_encode }}'></salla-multiple-bundle-product>
{% endif %}

{% if product.weight %}
    <div class="delivery-note">
        <i class="sicon-luggage-cart" aria-hidden="true"></i>
        <span>{{ trans('pages.products.weight') }}: <span class="product-weight">{{ product.weight }}</span></span>
    </div>
{% endif %}

{% if product.can_add_note %}
    <div>
        <label class="form-label" for="note_{{ product.id }}"><b>{{ trans('wow.product.add_note') }}</b></label>
        <textarea class="form-input" style="width:100%;min-height:70px;margin-top:0.5rem;"
                  id="note_{{ product.id }}"
                  placeholder="{{ trans('pages.products.notes_placeholder') }}"
                  name="notes">{{ product.notes }}</textarea>
    </div>
{% endif %}

{% if product.can_upload_file %}
    <salla-file-upload accept="image/png, image/jpeg, image/jpg, image/gif, video/*, application/pdf"
                       class="product-option-uploader"
            {% if is_page('cart') %}
                       files="{{ product.attachments | json_encode }}"
                       cart-item-id="{{ product.id }}"
            {% endif %}>
        <div class="product-option-uploader-placholder">
            <i class="sicon-camera" aria-hidden="true"></i>
            <p>{{ trans('common.uploader.drag_and_drop') }}</p>
            <span class="filepond--label-action">{{ trans('common.uploader.browse') }}</span>
        </div>
    </salla-file-upload>
{% endif %}
