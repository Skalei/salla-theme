{#
| Variable                    | Type       | Description               |
|-----------------------------|------------|---------------------------|
| landing                     | object     |                           |
| landing.title / .content    | string     |                           |
| landing.products            | Product[]  |                           |
| landing.offer_ends_at       | ?date      |                           |
| landing.is_expired          | bool       |                           |
| landing.is_slider           | bool       | slider vs fixed grid      |
| landing.show_store_features | bool       |                           |

    Landing page (Salla offer campaigns) — countdown builds the
    curiosity, the grid delivers the reveal.
#}
{% extends "layouts.master" %}

{% block content %}
    {% if landing is empty %}
        <div class="container">
            <div class="no-content-placeholder">
                <i class="sicon-cancel-circle" aria-hidden="true"></i>
                <h1>404</h1>
                <a class="btn btn--primary" href="{{ link('/') }}">{{ trans('common.elements.back_home') }}</a>
            </div>
        </div>
    {% elseif landing.is_expired %}
        <div class="container">
            <div class="landing-expired">
                <i class="sicon-clock" aria-hidden="true" style="font-size:3.5rem;color:var(--c-beige);"></i>
                <h1>{{ trans('wow.landing.expired_title') }}</h1>
                <a class="btn btn--primary" href="{{ link('/') }}">{{ trans('wow.landing.expired_cta') }}</a>
            </div>
        </div>
    {% else %}
        <div class="container">
            <header class="landing-header">
                <h1>{{ landing.title }}</h1>
                {% if landing.content %}
                    <div style="max-width:60ch;margin-inline:auto;color:var(--text-soft);">{{ landing.content | raw }}</div>
                {% endif %}
                {% if landing.offer_ends_at %}
                    <div style="margin-top:1.5rem;display:flex;justify-content:center;">
                        <salla-count-down date="{{ landing.offer_ends_at }}" boxed labeled></salla-count-down>
                    </div>
                {% endif %}
            </header>

            {% if landing.is_slider %}
                <salla-products-slider source="landing-page" source-value="{{ landing.id }}"
                                       block-title="{{ landing.title }}"></salla-products-slider>
            {% else %}
                <div class="cards-grid">
                    {% for product in landing.products %}
                        {% include 'components.product.card' with {product: product} %}
                    {% endfor %}
                </div>
            {% endif %}

            {% if landing.testimonials_type %}
                {% component 'home.testimonials' %}
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
