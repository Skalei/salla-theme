{#
| Variable     | Type       | Description                                        |
|--------------|------------|----------------------------------------------------|
| category     | ?Category  | name, url, sub_categories, image                   |
| filters      | bool       | is filtering allowed here                          |
| sort_options | SortList[] | id, name, is_selected                              |
| search_query | ?string    |                                                    |

    LISTING — clean grid, big imagery, filters, world-aware.
    If the category is mapped to a world (coffee_categories theme setting)
    the whole listing takes that world's mood + a world banner.
#}
{% extends "layouts.master" %}

{% block content %}
    {# ---- Resolve the world from the category mapping ---- #}
    {% set world = 'chocolate' %}
    {% set is_world_category = false %}
    {% if category %}
        {% set coffee_categories = theme.settings.get('coffee_categories', []) %}
        {% if coffee_categories %}
            {% for item in coffee_categories %}
                {% set item_id = item.value is defined ? item.value : item %}
                {% if item_id ~ '' == category.id ~ '' %}
                    {% set world = 'coffee' %}
                    {% set is_world_category = true %}
                {% endif %}
            {% endfor %}
        {% endif %}
    {% endif %}

    <div class="world-page" data-world="{{ world }}">
        {% if theme.settings.get('product_index_show_breadcrumbs', true) %}
            <div class="container">
                <nav class="breadcrumbs" aria-label="breadcrumb">
                    <salla-breadcrumb></salla-breadcrumb>
                </nav>
            </div>
        {% endif %}

        <div class="container">
            {% if is_world_category %}
                <header class="category-world-banner">
                    <div>
                        <span class="world-card__kicker">{{ trans('wow.worlds.coffee_kicker') }}</span>
                        <h1>{{ page.title | raw }}</h1>
                    </div>
                    {% if category.image %}
                        <img loading="eager" src="{{ category.image }}" alt="{{ category.name }}"
                             style="height:110px;width:110px;object-fit:cover;border-radius:var(--radius-m);">
                    {% endif %}
                </header>
            {% else %}
                <header class="listing-head">
                    <h1 class="listing-head__title" id="page-main-title">{{ page.title | raw }}</h1>
                    {% if search_query %}
                        <p class="listing-head__count">"{{ search_query }}"</p>
                    {% endif %}
                </header>
            {% endif %}

            <div class="listing-toolbar">
                {% if filters %}
                    <a href="#filters-menu" class="filters-trigger btn btn--ghost btn--sm" style="display:inline-flex;">
                        <i class="sicon-filter" aria-hidden="true"></i> {{ trans('pages.categories.filters') }}
                    </a>
                {% endif %}
                {% if sort_options | length %}
                    <div>
                        <label class="sr-only" for="product-filter">{{ trans('pages.categories.sorting') }}</label>
                        <select id="product-filter" class="form-input">
                            {% for sort in sort_options %}
                                <option value="{{ sort.id }}" {{ sort.is_selected ? 'selected' : '' }}>{{ sort.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
            </div>

            <div class="listing-layout">
                {% if filters %}
                    <salla-filters id="filters-menu"></salla-filters>
                {% endif %}

                <div class="listing-main">
                    {% hook 'product:index.items.start' %}
                    <salla-products-list source="{{ page.slug }}" source-value="{{ page.id }}"
                                         {{ filters ? 'filters-results' : '' }}></salla-products-list>
                    {% hook 'product:index.items.end' %}
                </div>
            </div>
        </div>

        {# Coffee-world listings get the bridge back to chocolate #}
        {% if is_world_category %}
            {% include 'components.brand.cross-pairing' with {world: world} %}
        {% endif %}
    </div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'js/product.js' | asset }}"></script>
{% endblock %}
