{#
    Customer area layout — shared shell for profile / orders / wishlist /
    notifications. Child pages use:
      {% extends "layouts.customer" %} + {% block inner_content %}
#}
{% extends "layouts.master" %}

{% block content %}
    <div class="container">
        <nav class="breadcrumbs" aria-label="breadcrumb">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>

        <div class="account-layout">
            <aside class="account-nav" aria-label="{{ trans('wow.account.profile') }}">
                {% if is_page('customer.profile') %}
                    <div style="text-align:center;margin-bottom:1rem;">
                        <salla-file-upload profile-image value="{{ user.avatar }}">
                            <span class="avatar-placeholder">
                                <i class="sicon-user" aria-hidden="true"></i>
                            </span>
                        </salla-file-upload>
                        <b>{{ trans('wow.account.welcome') }} {{ user.first_name }}</b>
                    </div>
                {% endif %}
                <salla-user-menu inline></salla-user-menu>
            </aside>

            <div class="account-main">
                {% block inner_title %}
                    <h1 style="margin-bottom:1.5rem;">{{ page.title }}</h1>
                {% endblock %}
                {% block inner_content %}{% endblock %}
            </div>
        </div>
    </div>
{% endblock %}
