{#
    Product card — reusable inside custom shelves.
    Usage: {% include 'components.product.card' with {product: product} %}
    The product is the hero: big image, minimal chrome.
#}
<article class="product-card">
    <div class="product-card__badges">
        {% if product.is_on_sale %}
            <span class="badge badge--accent">{{ product.discount_percentage }}</span>
        {% endif %}
        {% if product.promotion_title %}
            <span class="badge badge--new">{{ product.promotion_title }}</span>
        {% endif %}
    </div>

    <a href="{{ product.url }}" class="product-card__media" aria-label="{{ product.name }}">
        <img loading="lazy" width="600" height="600"
             src="{{ product.image.url | cdn(600) }}"
             alt="{{ product.image.alt ?: product.name }}">
    </a>

    <div class="product-card__body">
        <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.name }}</a></h3>
        <p class="product-card__price">
            {% if product.is_on_sale %}
                {{ product.sale_price | money }} <s>{{ product.regular_price | money }}</s>
            {% else %}
                {{ product.price | money }}
            {% endif %}
        </p>
        <div class="product-card__foot">
            {% if product.is_out_of_stock %}
                <span class="badge badge--soft">{{ trans('wow.product.out_of_stock') }}</span>
            {% else %}
                <salla-add-product-button product-id="{{ product.id }}" product-status="{{ product.status }}" product-type="{{ product.type }}">
                    {{ product.add_to_cart_label }}
                </salla-add-product-button>
            {% endif %}
        </div>
    </div>
</article>
