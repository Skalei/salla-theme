{#
    Twilight predefined: photos slider.
    Variables: items[] { url, image.url, image.alt, link_type }, position
#}
<section class="section section--tight photos-slider">
    <salla-slider type="carousel" class="home-slider" centered auto-play pagination id="photos-{{ position }}-slider">
        <div slot="items">
            {% for index, item in items %}
                <div class="swiper-slide">
                    <a href="{{ item.url }}">
                        <img class="photos-slider__img" loading="{{ loop.first ? 'eager' : 'lazy' }}" width="1200" height="500"
                             src="{{ item.image.url }}"
                             alt="{{ item.image.alt ?: store.name ~ ' slide ' ~ index }}">
                    </a>
                </div>
            {% endfor %}
        </div>
    </salla-slider>
</section>
