{#
    Twilight predefined: YouTube embed.
    Variables: youtube_id, position
#}
<section class="section section--tight youtube-block">
    <div class="container">
        <div style="position:relative;aspect-ratio:16/9;border-radius:var(--radius-l);overflow:hidden;background:var(--c-brown);">
            <iframe loading="lazy"
                    style="position:absolute;inset:0;width:100%;height:100%;border:0;"
                    src="https://www.youtube-nocookie.com/embed/{{ youtube_id }}"
                    title="{{ store.name }} video"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
        </div>
    </div>
</section>
