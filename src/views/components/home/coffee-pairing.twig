{#
    Chocolate × Coffee pairing — the bridge between the two worlds.
    Fields: image, title, description, products (chocolate + coffee picks), url
    The section deliberately borrows the coffee world's temperature.
#}
<section class="section section--tight" data-world="coffee">
    <div class="container">
        {% set pairing_url = url.url is defined ? url.url : url %}
        <div class="pairing">
            {% if pairing_url %}
                <a class="pairing__media" href="{{ pairing_url }}" aria-label="{{ title ?: trans('wow.worlds.coffee_tab') }}">
                    <img loading="lazy" width="1200" height="800" src="{{ image }}" alt="{{ title ?: trans('wow.worlds.coffee_tab') }}">
                </a>
            {% else %}
                <div class="pairing__media">
                    <img loading="lazy" width="1200" height="800" src="{{ image }}" alt="{{ title ?: trans('wow.worlds.coffee_tab') }}">
                </div>
            {% endif %}
            <div class="pairing__body">
                {% if title %}<h2>{{ title }}</h2>{% endif %}
                {% if description %}<p>{{ description }}</p>{% endif %}

                {% if products | length %}
                    <div class="pairing__products">
                        {% for product in products %}
                            <a class="pairing__mini" href="{{ product.url }}">
                                <img loading="lazy" src="{{ product.image.url | cdn(120) }}" alt="{{ product.image.alt ?: product.name }}">
                                <span>{{ product.name }}</span>
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if pairing_url %}
                    <a class="btn btn--deep" href="{{ pairing_url }}">{{ trans('wow.worlds.cross_cta') }}</a>
                {% endif %}
            </div>
        </div>
    </div>
</section>
